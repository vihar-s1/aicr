# aicr config — single source of lookup for everything in .ai/
#
# Format: KEY=value. No dependencies — shell-sourceable, greppable.
# Every other file in .ai/ refers to these keys instead of restating
# values. Change a number here, not in four markdown files.

# ── Model tiers ───────────────────────────────────────────────────
# Tier names are vendor-neutral on purpose. Map them to whatever
# assistant this project actually uses (Claude, Cursor, Copilot, ...).
# Leave a tier empty if the project doesn't distinguish it.
#
#   FAST      search, grep, file lookup, straightforward questions
#   BALANCED  default: bug fixes, feature work, edits
#   DEEP      architecture, code review, complex debugging

MODEL_FAST=
MODEL_BALANCED=
MODEL_DEEP=

# ── Effort per tier ───────────────────────────────────────────────
# How long the assistant reasons before answering.
# Claude Code: settings.json "effortLevel", or /effort mid-session.
# Valid values: low | medium | high | xhigh

EFFORT_FAST=low
EFFORT_BALANCED=medium
EFFORT_DEEP=high

# Fallback when a task matches no tier below.
EFFORT_DEFAULT=medium

# ── Routing policy ────────────────────────────────────────────────
# Which work belongs to which tier, as comma-separated intent
# keywords. A consumer matches the task against these and resolves
# the tier to its MODEL_<TIER> and EFFORT_<TIER>.
#
# Read by .ai/hooks/tier-context.sh, and by any external orchestrator
# that wants the same policy without re-deriving it. Keep the three
# lists disjoint — a keyword in two tiers is ambiguous, and
# validate.sh will flag it.

ROUTE_FAST=search,grep,find,locate,list,lookup,explain,describe,where,which
ROUTE_BALANCED=fix,implement,add,edit,update,refactor,rename,test,bug,feature
ROUTE_DEEP=review,architect,design,audit,security,migrate,debug,investigate,tradeoff

# ── Context limits ────────────────────────────────────────────────
# Enforced by .ai/hooks/context-guard.sh and checked by validate.sh.

MAX_FILES=25
WARN_FILES=15
MAX_FILE_LINES=400
AGENT_MD_MAX_LINES=150
AGENT_MD_SECTION_MAX_LINES=40

# ── Measurement ───────────────────────────────────────────────────
# Turns per session, used by `validate.sh --measure` to project the
# repeated cost of always-loaded files. Set it to your real average.

TURNS_PER_SESSION=40
